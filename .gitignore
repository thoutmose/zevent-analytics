# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets and local Twitch auth cache
.env
.env.nifi
.env.postgres
.tio.tokens.json

# dbt build artifacts — target/ and dbt_packages/ are dbt/dbt_project.yml's
# clean-targets (regenerated by `dbt build`/`dbt deps`); logs/ isn't a
# clean-target but is just as regenerated, every `dbt` invocation writes it
dbt/target/
dbt/dbt_packages/
dbt/logs/
# dbt CLI's local anonymous-usage-stats id, regenerated per machine
dbt/.user.yml

# Parquet output landing zone (one file per chat message/metadata snapshot)
data/

# Rotating log files (see logging.yaml / logging_setup.py)
logging/

# NiFi PutDatabaseRecord failures (docker-compose mounts this in) — production
# dead-letter payloads, not something to track in git. See DEPLOYMENT.md.
nifi/dead-letter/*
!nifi/dead-letter/.gitkeep

.claude/
