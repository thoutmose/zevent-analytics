# Twitch application credentials: https://dev.twitch.tv/console/apps
# main.py authenticates with an app access token (Client Credentials Grant),
# so the app must be registered as "Confidential" (not "Public") — Confidential
# is the only client type Twitch will issue a Client Secret for. OAuth Redirect
# URL is unused by this flow but Twitch still requires one; http://localhost:3000
# is fine. If your existing app is already "Public", Twitch won't let you
# switch it in place — register a second, dedicated app as Confidential instead.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# User-Agent sent by zevent_api.py, zevent_donation_goals.py, and
# emote_catalog.py on every request to zevent.fr/api/,
# api.ppr.evenmorestats.fr, and the three third-party emote APIs (see
# http_config.py). Update the contact info if this is deployed under a
# different identity.
HTTP_USER_AGENT=zevent-analytics/0.1 (https://github.com/thoutmose/zevent-analytics; contact: you@example.com)

# How many channels one anonymous IRC connection joins (main.py shards the
# full zevent.fr/api/ roster across ceil(n_channels / this) connections).
CHANNELS_PER_IRC_CONNECTION=50

# Delay (seconds) between successive IRC JOINs on one connection, to stay
# under Twitch's ~20 JOIN/PART per 10s rate limit for unverified connections.
IRC_JOIN_PACING_SECONDS=0.5

# How often (seconds) to poll the public zevent.fr/api/ endpoint. No auth
# needed. The API itself caches for 15s, so don't go much below that.
ZEVENT_API_POLL_INTERVAL_SECONDS=20

# Where zevent_api.py writes its checkpoint: the last successfully fetched
# snapshot, overwritten every poll (see Reliability mechanisms in README.md).
ZEVENT_CHECKPOINT_PATH=data/zevent_checkpoint.json

# Where main.py lands parquet files: data/live_chat/ (one file per chat
# message) and data/metadata/ (one file per snapshot below).
PARQUET_OUTPUT_DIR=data

# How often (seconds) to poll Helix (batched, all channels) and snapshot
# title/category/viewer_count/duration to a parquet file in data/metadata/.
METADATA_SNAPSHOT_INTERVAL_SECONDS=15

# How often (seconds) main.py re-fetches the zevent.fr/api/ roster to pick up
# a streamer who joins mid-event, without a restart. Streamers are only ever
# added here, never removed — see README.md "Known limitations".
ROSTER_REFRESH_INTERVAL_SECONDS=15

# How often (seconds) chatters seen in chat but not yet looked up get a
# batched Helix Get Users call for account_created_at/broadcaster_type.
CHATTER_LOOKUP_INTERVAL_SECONDS=30

# Rows buffered per parquet file (live_chat and metadata each roll over to a
# new, sequentially part-numbered file once they hit this many rows).
MAX_ROWS_PER_PARQUET_FILE=100000

# How often (seconds) buffered rows are flushed to disk regardless of
# MAX_ROWS_PER_PARQUET_FILE, so data lands on disk during long runs instead
# of only at shutdown.
FLUSH_INTERVAL_SECONDS=30

# Parquet compression codec (anything pyarrow.parquet.write_table accepts:
# zstd, snappy, gzip, brotli, lz4, none).
PARQUET_COMPRESSION=zstd

# --- archive_parquet.py: moves old local Parquet files to cold storage ---
# SSH destination for archived files. Recommended: define a `Host
# srv-services` alias in your own ~/.ssh/config (HostName/User/IdentityFile)
# so this script needs no credentials of its own — it just shells out to
# ssh/rsync and relies on your ambient SSH config/agent, same as CD's
# rsync-over-SSH deploy step.
ARCHIVE_REMOTE_HOST=srv-services

# Remote directory archived files land in (relative to the SSH user's home
# unless given as an absolute path). live_chat/ and metadata/ are mirrored
# under it.
ARCHIVE_REMOTE_PATH=zevent-parquet-archive

# Minimum age (seconds) a local Parquet file must reach before
# archive_parquet.py will consider it — a safety margin against picking up
# a file mid-write, deliberately not tied to FLUSH_INTERVAL_SECONDS (see
# archive_parquet.py's module docstring for why).
ARCHIVE_MIN_AGE_SECONDS=600

# --- archive_logs.py: moves closed/rotated log backups to cold storage ---
# Shares ARCHIVE_REMOTE_HOST above (same server, same SSH access) - only the
# destination directory differs. Never touches the active files
# logging.yaml's handlers are currently writing to (info.log, debug.log,
# etc.), only already-rotated backups (e.g. debug.log.3, debug.log.3.gz).
ARCHIVE_LOGS_REMOTE_PATH=zevent-logs-archive

# "development" (console + every rotating file under logging/, see
# logging.yaml) or "production" (console + logging/info.log only).
APP_ENV=development

# --- Optional: push extraction batches to NiFi (see ARCHITECTURE.md) ---
# ListenHTTP endpoint of the NiFi ingestion flow. Leave unset to keep the
# current parquet-only / stdout-only behavior unchanged.
NIFI_WEBHOOK_URL=
NIFI_REQUEST_TIMEOUT_SECONDS=10
# Retries per batch on a 503 (ListenHTTP backpressure) or ambiguous connection
# failure, with exponential backoff starting at NIFI_RETRY_BACKOFF_SECONDS. Safe to
# retry: batch_id is stable across attempts, so a replay that already landed is a
# no-op downstream (ON CONFLICT), not a duplicate. See nifi_client.py.
NIFI_MAX_RETRIES=4
NIFI_RETRY_BACKOFF_SECONDS=1.0

# --- zevent_donation_goals.py: donation goal poller (zevent.gdoc.fr backend) ---
# How often (seconds) to re-poll every streamer's donation goals. Goals change
# far less often than chat/viewer counts, hence the longer default interval.
DONATION_GOALS_POLL_INTERVAL_SECONDS=300

# Max concurrent /participations/{id}/donation_goals requests (no documented
# rate limit upstream — this is a "be a polite crawler" default).
DONATION_GOALS_MAX_CONCURRENCY=5

# Where zevent_donation_goals.py writes its checkpoint: the last successfully
# fetched snapshot, overwritten every poll (same role as ZEVENT_CHECKPOINT_PATH).
DONATION_GOALS_CHECKPOINT_PATH=data/donation_goals_checkpoint.json

# --- emote_catalog.py: Twitch/7TV/BetterTTV/FrankerFaceZ emote set poller ---
# How often (seconds) to re-fetch every channel's + each service's global
# emote set. Emote sets are effectively static for the life of an event,
# hence the much longer default than everything else this repo polls.
EMOTE_CATALOG_POLL_INTERVAL_SECONDS=1800

# Max concurrent per-channel emote-set requests, across all four services
# combined (no documented rate limit upstream for 7TV/BetterTTV/FrankerFaceZ —
# same "be a polite crawler" reasoning as DONATION_GOALS_MAX_CONCURRENCY).
EMOTE_CATALOG_MAX_CONCURRENCY=10

# Where emote_catalog.py writes its checkpoint: the last successfully fetched
# catalog, overwritten every poll (same role as ZEVENT_CHECKPOINT_PATH).
EMOTE_CATALOG_CHECKPOINT_PATH=data/emote_catalog_checkpoint.json

# --- docker-compose (local NiFi stack — see docker-compose.yml) ---
# This is only for the NiFi container itself (srv-prod also runs the prod
# extractors, but those read the variables above, not these). PgBouncer and
# PostgreSQL live on srv-db and are configured there, not here — see
# ARCHITECTURE.md.
# NiFi single-user UI login. Password must be at least 12 characters.
NIFI_ADMIN_USERNAME=admin
NIFI_ADMIN_PASSWORD=

# Public hostname the external reverse proxy (on a separate server) forwards
# to NiFi under. NiFi rejects requests whose Host header isn't in this list.
NIFI_WEB_PROXY_HOST=nifi.thoutmose.me

# NiFi JVM heap (init/max). Defaults in docker-compose.yml (4g/8g) are sized for a
# 16 GB srv-prod host, leaving the rest for the OS page cache the content/provenance
# repositories lean on — lower if the host has less, raise only if throughput testing
# (stress_test.py) shows GC pressure at the current setting. See ARCHITECTURE.md,
# "Tuning for higher throughput".
NIFI_JVM_HEAP_INIT=4g
NIFI_JVM_HEAP_MAX=8g

# --- dbt (dbt/ — see README.md's "Data transformation (dbt)") ---
# Not read by any Python script in this repo — only dbt/profiles.yml
# (env_var()) and, for humans setting up NiFi's DBCPConnectionPool by hand,
# ARCHITECTURE.md. PGBOUNCER_PORT is 16432 on srv-dev (host-mapped from the
# pgbouncer container's internal 5432), not the 6432 assumed in
# ARCHITECTURE.md — check that container's compose file for the real value.
POSTGRES_HOST=
PGBOUNCER_PORT=
POSTGRES_DB=zevent-dev
POSTGRES_USER=
POSTGRES_PASSWORD=

# Which dbt/profiles.yml output to use: dev = POSTGRES_DB above (zevent-dev
# locally), prod = zevent on srv-prod (see DEPLOYMENT.md's "Running dbt" —
# on srv-prod this is set by run_dbt.sh, not read from this file).
DBT_TARGET=dev
