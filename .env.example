# Twitch application credentials: https://dev.twitch.tv/console/apps
# OAuth Redirect URL for the app can be left at the default (http://localhost:3000)
# since this script uses Device Code Flow, not a redirect-based login.
TWITCH_CLIENT_ID=

# How many channels one anonymous IRC connection joins (main.py shards the
# full zevent.fr/api/ roster across ceil(n_channels / this) connections).
CHANNELS_PER_IRC_CONNECTION=50

# Delay (seconds) between successive IRC JOINs on one connection, to stay
# under Twitch's ~20 JOIN/PART per 10s rate limit for unverified connections.
IRC_JOIN_PACING_SECONDS=0.5

# How often (seconds) to poll the public zevent.fr/api/ endpoint. No auth
# needed. The API itself caches for 15s, so don't go much below that.
ZEVENT_API_POLL_INTERVAL_SECONDS=20

# Where main.py lands parquet files: data/live_chat/ (one file per chat
# message) and data/metadata/ (one file per snapshot below).
PARQUET_OUTPUT_DIR=data

# How often (seconds) to poll Helix (batched, all channels) and snapshot
# title/category/viewer_count/duration to a parquet file in data/metadata/.
METADATA_SNAPSHOT_INTERVAL_SECONDS=15

# Rows buffered per parquet file (live_chat and metadata each roll over to a
# new, sequentially part-numbered file once they hit this many rows).
MAX_ROWS_PER_PARQUET_FILE=100000

# How often (seconds) buffered rows are flushed to disk regardless of
# MAX_ROWS_PER_PARQUET_FILE, so data lands on disk during long runs instead
# of only at shutdown.
FLUSH_INTERVAL_SECONDS=30

# Parquet compression codec (anything pyarrow.parquet.write_table accepts:
# zstd, snappy, gzip, brotli, lz4, none).
PARQUET_COMPRESSION=zstd

# "development" (console + every rotating file under logging/, see
# logging.yaml) or "production" (console + logging/info.log only).
APP_ENV=development

# --- Optional: push extraction batches to NiFi (see ARCHITECTURE.md) ---
# ListenHTTP endpoint of the NiFi ingestion flow. Leave unset to keep the
# current parquet-only / stdout-only behavior unchanged.
NIFI_WEBHOOK_URL=
NIFI_REQUEST_TIMEOUT_SECONDS=10

# --- docker-compose (local NiFi stack — see docker-compose.yml) ---
# This server (srv-prod) runs NiFi only. PgBouncer and PostgreSQL live on
# srv-db and are configured there, not here — see ARCHITECTURE.md.
# NiFi single-user UI login. Password must be at least 12 characters.
NIFI_ADMIN_USERNAME=admin
NIFI_ADMIN_PASSWORD=

# Public hostname the external reverse proxy (on a separate server) forwards
# to NiFi under. NiFi rejects requests whose Host header isn't in this list.
NIFI_WEB_PROXY_HOST=nifi.thoutmose.me
